+// Runs a few seconds of silence through the model so the first real request
+// does not pay for graph building and weight repacking (several seconds on a
+// phone). Optional; the CLI does the same before its first request.
+NEMO_SPEECH_ASR_API nemo_speech_asr_status
+nemo_speech_asr_warmup(nemo_speech_asr_recognizer* recognizer);
